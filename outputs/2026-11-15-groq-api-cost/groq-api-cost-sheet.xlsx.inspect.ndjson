{"kind":"table","sheet":"Groq API Cost","address":"A1:J34","rows":34,"cols":10,"values":[["GROQ API COST ESTIMATOR",null,null,null,null,null,null,null,null,null],["Editable usage assumptions • text-model API charges only • USD and indicative INR",null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null],["USAGE ASSUMPTIONS (edit green cells)","Value",null,null,null,null,null,null,null,null],["Documents processed per month",100000,null,null,null,null,null,null,null,null],["Average input tokens per document",2000,null,null,null,null,null,null,null,null],["Average output tokens per document",200,null,null,null,null,null,null,null,null],["Planning exchange rate (₹ per US$)",90,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null],["INVOICE AI COST (based on inputs above)","Input $ / 1M tokens","Output $ / 1M tokens","Monthly input tokens","Monthly output tokens","Input cost / month (US$)","Output cost / month (US$)","Total / month (US$)","Indicative total / month (₹)",null],["GPT OSS 20B",0.075,0.3,200000000,20000000,15,6,21,1890,null],["GPT OSS 120B",0.15,0.6,200000000,20000000,30,12,42,3780,null],[null,null,null,null,null,null,null,null,null,null],["COST EXAMPLE AT DEFAULT INPUTS",null,null,null,null,null,null,null,null,null],["At 100,000 invoices × 2,000 input tokens + 200 output tokens each: GPT OSS 20B ≈ $21/batch (about ₹1,890 at the editable planning FX rate); GPT OSS 120B ≈ $42/batch (about ₹3,780).",null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null],["WHAT THIS ESTIMATE INCLUDES / EXCLUDES",null,null,null,null,null,null,null,null,null],["Includes model input/output token usage at the listed rates. Excludes OCR, hosting, database/storage, payment/bank conversion charges and applicable taxes. Scanned invoice/PDF image reading may need a separate OCR service; sending extracted text to Groq is what this estimate models.",null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null],["Sources: Groq Supported Models pricing table — https://console.groq.com/docs/models | Prices checked 15 Nov 2026. Exchange rate is a planning assumption only; edit B8.",null,null,null,null,null,null,null,null,null],[null,null,null,null,null,null,null,null,null,null],["OTHER AI WORKFLOWS — edit green monthly volumes and token assumptions",null,null,null,null,null,null,null,null,null],["Workflow","Items / month","Input tokens / item","Output tokens / item","Monthly input tokens","Monthly output tokens","20B cost (US$)","120B cost (US$)","Notes / estimate basis",null],["Bank narration categorisation",0,100,30,0,0,0,0,"Per transaction; rules can handle clear narrations",null],["GST mismatch explanation",0,1200,250,0,0,0,0,"Per mismatch explanation; matching itself can be rules-based",null],["Unclear reconciliation suggestion",0,250,80,0,0,0,0,"Per candidate match",null],["Notice / letter summary",0,5000,700,0,0,0,0,"Per notice; OCR for scans is separate",null],["Audit exception explanation",0,500,150,0,0,0,0,"Per flagged exception",null],["MIS report summary",0,3000,500,0,0,0,0,"Per generated report summary",null],["Client reminder draft",0,300,100,0,0,0,0,"Per reminder draft",null],[null,null,null,null,null,null,null,null,"20B total (₹)","120B total (₹)"],["TOTAL API ESTIMATE — 100,000 invoices + additional workflows above",null,null,null,200000000,20000000,21,42,1890,3780],[null,null,null,null,null,null,null,null,null,null],["Additional workflow volumes are set to zero until you enter your actual monthly counts. Token/item figures are starter estimates—replace them with observed usage after a pilot. The 100,000 invoice batch is the volume you asked about; it is not assumed to recur every month.",null,null,null,null,null,null,null,null,null]]}
