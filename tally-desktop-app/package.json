{
  "name": "kiran-tally-bridge",
  "version": "1.2.0",
  "description": "CA Kiran K. Shinde & Co. — TallyPrime Cloud Sync Desktop Connector",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "node node_modules/electron-builder/cli.js --dir",
